# ==============================================================================
# EazyPage - Self-Hosted Static HTML Hosting Portal on Vercel
# Environment Configuration
# ==============================================================================

# Admin Security
# Passkey required to upload or replace static pages via UI and API
ADMIN_PASSKEY=supersecretpasskey123

# Deployment Mode: "github" or "vercel_direct"
# - github: Commits to the GitHub repo under public/sites/<slug>/index.html triggering automatic Vercel redeploy
# - vercel_direct: Directly deploys static files via Vercel REST API (v13 deployments)
DEPLOY_MODE=github

# Public Domain / Base URL (optional, defaults to Vercel production domain or request origin)
# NEXT_PUBLIC_BASE_URL=https://pages.yourdomain.com

# ------------------------------------------------------------------------------
# Mode A: GitHub-Backed Configuration (Required when DEPLOY_MODE=github)
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (PAT) with 'repo' or contents write scope
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# GitHub repository in 'owner/repo' format (can be this repository or a dedicated static sites repo)
GITHUB_REPO=your-org-or-username/eazy-page

# Target branch (defaults to 'main')
GITHUB_BRANCH=main

# ------------------------------------------------------------------------------
# Mode B: Direct Vercel API Configuration (Required when DEPLOY_MODE=vercel_direct)
# ------------------------------------------------------------------------------
# Vercel Personal Access Token or Team Token from vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_api_token_here

# Target Vercel Project Name or ID
VERCEL_PROJECT_NAME=sites-hub

# Vercel Team ID (optional, required if project belongs to a Vercel Team)
# VERCEL_TEAM_ID=team_xxxxxxxxxxxx
